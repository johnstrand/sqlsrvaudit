<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.5" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.22.0.136894">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlAudit.Core\SqlAudit.Core.csproj" />
    <ProjectReference Include="..\SqlAudit.SqlServer\SqlAudit.SqlServer.csproj" />
    <ProjectReference Include="..\SqlAudit.Reporting\SqlAudit.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\project-config\sqlaudit.quick.json" LogicalName="SqlAudit.Cli.ConfigPresets.sqlaudit.quick.json" />
    <EmbeddedResource Include="..\..\project-config\sqlaudit.deep.json" LogicalName="SqlAudit.Cli.ConfigPresets.sqlaudit.deep.json" />
    <EmbeddedResource Include="..\..\project-config\sqlaudit.deep-strict.json" LogicalName="SqlAudit.Cli.ConfigPresets.sqlaudit.deep-strict.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.45" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

</Project>
